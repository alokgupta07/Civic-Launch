# Copy this file to .env and adjust as needed. Never commit the real .env.

# Defaults to a local SQLite file — works with zero setup.
# For Postgres: postgresql://user:password@localhost:5432/gov_innovate
DATABASE_URL=sqlite:///./gov_innovate.db

JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated origins allowed to call this API from the browser.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
